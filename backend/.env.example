# =============================================
# Backend Environment Variables (FastAPI)
# คัดลอกเป็น backend/.env แล้วแก้ค่าตามเครื่องจริง
# =============================================

# Server
HOST=0.0.0.0
PORT=8000

# CORS — Frontend origins ที่อนุญาต (คั่นด้วยคอมม่า)
ALLOWED_ORIGINS=http://localhost:5173

# Database (PostgreSQL) — โค้ดแปลง postgresql:// → postgresql+asyncpg:// ให้
DATABASE_URL=postgresql+asyncpg://robot:robot123@localhost:5432/robot_settings

# Robot (Dobot) — ค่าเหล่านี้ OVERRIDE ค่า default ใน maps_point/config.py
ROBOT_IP=192.168.10.110
ROBOT_PORT=29999

# JWT — ต้องตั้งเป็นค่าสุ่มยาว ๆ ใน production (auth.py อ่าน JWT_SECRET)
JWT_SECRET=change-me-in-production

# Blynk relay
BLYNK_TOKEN=
