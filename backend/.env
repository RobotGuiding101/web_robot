# =============================================
# Backend Environment Variables (FastAPI)
# =============================================

# Server
HOST=0.0.0.0
PORT=8000

# CORS — Frontend origins ที่อนุญาต (คั่นด้วยคอมม่า)
ALLOWED_ORIGINS=http://localhost:5173

# Robot Hardware
ROBOT_IP=192.168.1.6
ROBOT_PORT=29999

# Secret key สำหรับ JWT (เปลี่ยนเป็นค่าสุ่มใน production)
SECRET_KEY=change-me-in-production
