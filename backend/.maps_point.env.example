# ── moveFlask/main.py — fully self-contained, does NOT read move/.env.local ──
# หรือ .env.pick_45degree — ก็อปปี้ค่าที่ต้องใช้ร่วมมาไว้ในนี้เอง (ตามแพทเทิร์นที่ตั้งไว้กับ
# pick_45degree.py) แก้ไฟล์นี้อย่างเดียวพอสำหรับเว็บนี้

# ── Robot ─────────────────────────────────────────────────────────────────────
ROBOT_IP=192.168.10.110

# ── Camera ────────────────────────────────────────────────────────────────────
DEPTH_CAM_SERIAL=215122252229

# ── Robot speed ───────────────────────────────────────────────────────────────
Z_CALIB_SPEED=10

# ── Depth sampling ────────────────────────────────────────────────────────────
DEPTH_N_FRAMES=30
DEPTH_ROI=15
MIN_DEPTH_MM=330.0

# ── Camera-to-robot axis sign ─────────────────────────────────────────────────
# ค่านี้ตรงกับที่ยืนยันแล้วใน move/.env.pick_45degree (2026-07-23) — แกน
# u(ซ้าย-ขวาของภาพ)→Y ของหุ่น, v(บน-ล่างของภาพ)→X ของหุ่น (ดู _cam_xy_to_robot ในโค้ด)
CAM_X_SIGN=1
CAM_Y_SIGN=-1

# ── offset กล้อง vs TCP (robot frame, mm) ──────────────────────────────────
# ยังไม่วัด (0.0) — ใช้แค่ตอน "move to center" ก่อน align (ตำแหน่งคร่าวๆ ไม่ใช่
# จุดจิ้มแม่นยำ) ถ้าจะวัดดูตัวอย่างที่ move/pick_45degree.py
CAM_TCP_OFFSET_X=0.0
CAM_TCP_OFFSET_Y=0.0

# ── Tool index (DobotStudio Pro → Tool Coordinate) — ปลาย probe, pivot ตอน align ─
WELD_TOOL_INDEX=2

# ── align mode (หมุนอยู่กับที่ให้ระนาบ tool ตรงกับวัตถุ, pivot=Tool 1) ────────
# ก่อนหมุน: เลื่อนไปกึ่งกลางจุดที่ mark ไว้ก่อน (Z=HOME_Z) แล้วค่อย probe หาทิศทาง
# แล้วค่อยลู่เข้า — ใกล้ converge (tilt <= ALIGN_FINE_TILT_DEG) จะลดขนาดก้าวลง
# (ALIGN_FINE_SCALE) ให้เนียนขึ้น ไม่โอเวอร์ชูตตอนใกล้เสร็จ
ALIGN_GAIN_DEG=20.0        # deg ที่หมุนต่อ 1.0 หน่วยของ normal component
ALIGN_MAX_STEP_DEG=5.0     # จำกัดมุมสูงสุดต่อรอบ (safety)
ALIGN_TOL_DEG=1.5          # tilt ต่ำกว่านี้ถือว่า align สำเร็จ
ALIGN_MAX_STEPS=100        # จำนวน step รวมสูงสุดก่อนเลิกถ้ายังไม่ converge (ceiling ไม่ใช่เป้า, ค่าตรงๆ ไม่คูณ 2 แล้ว)
ALIGN_PROBE_DEG=3.0        # มุมทดสอบต่อแกน ก่อนเริ่ม loop จริง (หาทิศทางที่ถูก)
ALIGN_FINE_TILT_DEG=5.0    # tilt ต่ำกว่านี้ถือว่า "ใกล้แล้ว" เริ่มลดขนาดก้าว
ALIGN_FINE_SCALE=0.4       # ตัวคูณลดขนาดก้าวตอนอยู่ช่วง fine
ALIGN_APPROACH_Z_OFFSET=50.0  # ยกเพิ่มจาก HOME_Z ตอน "move to center" (แค่ตอน align — Goto ยังไป HOME_Z ตรงๆ)
ALIGN_DIVERGE_MARGIN_DEG=0.5  # tilt แย่ลงเกินนี้ถึงจะนับเป็น "แย่ลงจริง" (กันสัญญาณรบกวน)
ALIGN_DIVERGE_STREAK=2        # แย่ลงติดต่อกันกี่ครั้งถึง abort (กันหมุนผิดทางไปเรื่อยๆ)
ALIGN_RECENTER_MARGIN=0.12    # จุด track ใกล้ขอบเฟรมเกินสัดส่วนนี้ (0-0.5) จะขยับ XY กลับกึ่งกลางก่อนหมุนต่อ

# ── draw mode (สอน grid จุดบนวัตถุ แล้ววาดอิสระบน canvas ให้หุ่นวิ่งตามบนพื้นผิวจริง) ──
# grid N×M — 2×2 คือ 4 มุมแบบง่ายสุด, มากกว่านั้นช่วยรองรับพื้นผิวที่ไม่เรียบสนิท/ไม่เป็นสี่เหลี่ยมจริง
DRAW_SIMPLIFY_EPS=0.015    # ลด point จาก freehand stroke ก่อนส่งเคลื่อนที่จริง (หน่วย canvas fraction 0-1)
DRAW_MAX_POINTS=60         # เพดาน waypoint สูงสุดหลัง simplify
DRAW_MAX_RMSE_MM=3.0       # เช็คว่าจุด grid ที่สอนมาแบนจริงแค่ไหน (rmse ของ plane fit)
DRAW_GRID_MAX_ROWS=7       # เพดานขนาด grid กันพิมพ์ผิดแล้วต้องสอนเป็นร้อยจุด
DRAW_GRID_MAX_COLS=7
# เคลื่อนที่แบบ blended จริง (CR5 queue + CP corner-rounding) ไม่ใช่หยุดสนิททีละจุด
DRAW_CP_RATIO=20                    # smooth transition ratio (1-100) — เผื่อไว้ก่อนเพราะยังไม่ได้ทดสอบกับหุ่นจริง
DRAW_PATH_TIMEOUT_PER_POINT_S=1.0   # timeout ต่อ waypoint ตอนรอทั้ง path จบ

# โหมดการเคลื่อนที่ตอนวาด: "cp" = movl_path (MovL คิวต่อกัน + CP blend, ยังเห็นเป็นเส้นตรงๆ
# ถ้า waypoint น้อย) / "servo" = servo_stream (ยิง ServoP รัวๆ ต่อเนื่องจริง บน path ที่ถูก
# densify ให้ถี่ก่อน) — เพิ่ม 2026-08-16 ตามที่ขอ ยังไม่เคยทดสอบบนหุ่นจริงทั้งคู่ ถ้า servo
# มีปัญหาบนหุ่นจริง เปลี่ยนกลับเป็น cp ตรงนี้ได้เลยไม่ต้องแก้โค้ด
DRAW_MOTION_MODE=servo
DRAW_SERVOP_RATE_HZ=50               # ความถี่ยิง ServoP (ครั้ง/วินาที) — ของจริงรองรับ ~100Hz+ แต่เริ่มระวังไว้ก่อน
DRAW_SERVOP_STEP_MM=1.0              # ระยะห่างสูงสุดระหว่างจุดหลัง densify (มม.) — ยิ่งน้อยยิ่งลื่นแต่จุดเยอะขึ้น
DRAW_SERVOP_MAX_STREAM_POINTS=4000   # เพดานจำนวนจุดหลัง densify กันสโตรกยาวมากทำให้จุดเยอะเกินไป
DRAW_SERVOP_ERROR_CHECK_S=0.25       # ความถี่เช็ค error state ของคอนโทรลเลอร์ระหว่างยิง (ไม่ใช่ทุกจุด กันตีจังหวะ rate)
DRAW_SERVOP_SETTLE_S=0.5             # เวลารอเผื่อ lag ของ internal follow filter ก่อนเช็คว่านิ่งจริง
DRAW_LIFT_MM=15.0                    # ยกปากกา (มม., แกน Z ของ robot base) ตอนข้ามจากเส้น/รูปหนึ่งไปอีกอันบนหน้า Draw

# ── home position (absolute robot pose) ───────────────────────────────────────
#Use only Coordinate User!!!
HOME_X=-145.6
HOME_Y=-290.9
HOME_Z=600
HOME_RX=-179.5
HOME_RY=0.2066
HOME_RZ=177.04

# ── Flask ─────────────────────────────────────────────────────────────────────
#FLASK_HOST=192.168.10.104
#FLASK_PORT=5000
