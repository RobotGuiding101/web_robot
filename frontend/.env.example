# =============================================
# Frontend Environment Variables (Vite)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อม
# =============================================

# URL ของ Backend API (เปลี่ยนเป็น IP จริงของ Robot Server เมื่อ deploy)
VITE_API_URL=http://localhost:8000

# WebSocket URL สำหรับ Live Robot Connection
VITE_WS_URL=ws://localhost:8000
